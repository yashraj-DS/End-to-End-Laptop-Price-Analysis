   "metadata": {},
   "source": [
    "## 16. Sample Screen Resolution Values"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "8bc4e8a2",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "696                       Full HD 1920x1080\n",
       "4        IPS Panel Retina Display 2560x1600\n",
       "1212                      Full HD 1920x1080\n",
       "190     4K Ultra HD / Touchscreen 3840x2160\n",
       "67                        Full HD 1920x1080\n",
       "1086                      Full HD 1920x1080\n",
       "Name: ScreenResolution, dtype: str"
      ]
     },
     "execution_count": 16,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# Before parsing ScreenResolution, we look at raw sample values to understand the structure.\n",
    "# The column packs multiple pieces of info into one string, for example:\n",
    "#   \"IPS Panel Full HD 1920x1080\"\n",
    "#   \"Touchscreen 2560x1440\"\n",
    "#   \"4K Ultra HD 3840x2160\"\n",
    "# We need to unpack: panel type, touchscreen flag, and pixel resolution as separate columns.\n",
    "df['ScreenResolution'].sample(6)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f47614bd",
   "metadata": {},
   "source": [
    "## 17. Extract Panel Type"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "084467b5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# IPS = better colour accuracy and viewing angles vs standard TN panels.\n",
    "# Everything else defaults to \"Standard Panel\".\n",
    "df['Panel Type'] = df['ScreenResolution'].apply(lambda x: 'IPS Panel' if 'ips' in x.lower() else 'Standard Panel')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b9457f25",
   "metadata": {},
   "source": [
    "## 18. Extract Touchscreen"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "fe19a622",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['Touchscreen'] = df['ScreenResolution'].apply(lambda x: 'Touchscreen' if 'touchscreen' in x.lower() else 'Standard Screen')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1b3fa9e5",
   "metadata": {},
   "source": [
    "## 19. Extract Pixel Resolution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "bc1c9e98",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['Pixel Resolution'] =df['ScreenResolution'].str.extract(r'(\\d+x\\d+)').fillna('Unknown')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3d3f84cb",
   "metadata": {},
   "source": [
    "## 20. Clean Inches Column"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "714964a8",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['Inches'] = df['Inches'].str.strip().str.replace(r'[^\\d.]','',regex=True).replace('',None).astype('float')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b3f41c1b",
   "metadata": {},
   "source": [
    "## 21. Extract CPU Clock Speed (GHz)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "c60c5f30",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['GHz'] = df['Cpu'].str.extract(r'(\\b\\d+\\.\\d+GHz)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "5e56bc9c",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert GHz to Float\n",
    "df['GHz'] = df['GHz'].str.replace('GHz','').astype('float')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "062e5eeb",
   "metadata": {},
   "source": [
    "## 22. Clean CPU Name"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "67700cc2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Now that GHz is in its own column, we remove the clock speed from the Cpu name.\n",
    "# Goal: Cpu should describe the processor model, not mix in the speed.\n",
    "# \"Intel Core i5-8250U 1.60GHz\" -> \"Intel Core i5-8250U\"\n",
    "df[\"Cpu\"] = df[\"Cpu\"].str.replace(r\"\\b\\d+\\.?\\d+GHz\",\"\", regex=True).str.strip().astype('category')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e43a63a3",
   "metadata": {},
   "source": [
    "## 23. Clean RAM Column"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "9ab4b2a6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# RAM is stored as strings like \"8GB\", \"16GB\", \"32GB\".\n",
    "# Strip the \"GB\" unit and convert to integer — now RAM is a clean numeric column.\n",
    "df['Ram'] = df['Ram'].str.replace(r'GB','',regex=False).astype('int')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a4da2b04",
   "metadata": {},
   "source": [
    "## 24. Memory cleaning"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "83ef5bd0",
   "metadata": {},
   "source": [
    "### Combine Dual-SSD Memory Entries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "17ddbd32",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "512 28\n",
      "1024 259\n",
      "768 338\n",
      "512 880\n"
     ]
    }
   ],
   "source": [
    "a = df[(df['Memory'].str.contains(r'\\+'))&~(df['Memory'].str.contains(r'HDD|Hybrid'))]\n",
    "ar = np.array(a['Memory'].str.findall(r'\\d+'))\n",
    "az = []\n",
    "bz = []\n",
    "for i,z in ar:\n",
    "    az.append(i)\n",
    "    bz.append(z)\n",
    "ar1 = np.array(az).astype('int')\n",
    "ar2 = np.array(bz).astype('int')\n",
    "result = ar1+ar2\n",
    "for index,values in zip(a.index,result):\n",
    "    print(values,index)\n",
    "    df.loc[index,'Memory'] = f'{values}GB SSD'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "22d6462e",
   "metadata": {},
   "outputs": [
    {
     "data": {
