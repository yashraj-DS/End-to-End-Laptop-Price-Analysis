   "source": [
    "df['Company'] = df['Company'].str.strip().astype('category')\n",
    "df['TypeName'] = df['TypeName'].str.strip().astype('category')\n",
    "# Drop ScreenResolution — all useful info already extracted into separate columns\n",
    "df.drop(columns='ScreenResolution',inplace=True)\n",
    "# Rename Ram into Ram (Gb) to make the unit explicit in the column name\n",
    "df['Ram (Gb)']= df['Ram']\n",
    "df.drop(columns='Ram',inplace=True)                         # drop original column Ram column\n",
    "df['Cpu'] = df['Cpu'].str.strip().astype('category')\n",
    "df['Gpu'] = df['Gpu'].astype('object')                      # kept object: too many unique GPU models for category\n",
    "df['Gpu Brand'] = df['Gpu Brand'].astype('category')\n",
    "df['Weight (Kg)'] = df['Weight (Kg)'].astype('float').round(2)\n",
    "df.drop(columns=['Weight'],inplace=True)                    # drop original column Weight\n",
    "df['Price']= df['Price'].round(2)                           # round to 2 decimal places\n",
    "df['Panel Type'] = df['Panel Type'].astype('category')\n",
    "df['Touchscreen'] = df['Touchscreen'].astype('category')\n",
    "df['Pixel Resolution']=df['Pixel Resolution'].astype('category')\n",
    "df['Primary Memory'] = df['Primary Memory'].astype('int')\n",
    "df['Primary Memory Type'] = df['Primary Memory Type'].astype('category')\n",
    "df['Extra Memory'] = df['Extra Memory'].astype('int')\n",
    "df['Extra Memory Type']= df['Extra Memory Type'].astype('category')\n",
    "\n",
    "# Final cleaned dataframe\n",
    "df"
   ]
  },
